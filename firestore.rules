rules_version = '2';

// Luật Cloud Firestore của TravelGo.
// Cách dùng: Firebase Console → Firestore Database → tab Rules → dán toàn bộ file này → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // Báo "quán đã đóng cửa": closed_reports/{id quán}
    //   name, lat, lng, reporters (danh sách uid người báo), updatedAt (giờ máy chủ)
    match /closed_reports/{placeId} {
      // Người đã đăng nhập (kể cả khách ẩn danh) mới được đọc.
      allow read: if request.auth != null;

      // Người đầu tiên báo: chỉ được ghi đúng các trường này, danh sách người báo chỉ có chính mình.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['name', 'lat', 'lng', 'reporters', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 200
        && request.resource.data.lat is number
        && request.resource.data.lng is number
        && request.resource.data.reporters == [request.auth.uid]
        && request.resource.data.updatedAt == request.time;

      // Người báo sau: chỉ được thêm đúng uid của mình vào danh sách (mỗi người một lần),
      // không được xoá tên người khác, không được sửa tên hay toạ độ quán.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reporters', 'updatedAt'])
        && !(request.auth.uid in resource.data.reporters)
        && request.resource.data.reporters.size() == resource.data.reporters.size() + 1
        && request.resource.data.reporters.hasAll(resource.data.reporters)
        && request.auth.uid in request.resource.data.reporters
        && request.resource.data.reporters.size() <= 500
        && request.resource.data.updatedAt == request.time;

      // Không ai xoá được từ app; quản trị viên xoá trên Firebase Console nếu quán mở lại.
      allow delete: if false;
    }

    // Mọi dữ liệu khác: chặn.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
